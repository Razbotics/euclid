# Shared local-dev configuration — committed, safe defaults only.
# Override per-machine in .env.local (gitignored). Real secrets NEVER go here;
# production values are set with `wrangler secret put`.
#
# Consumed three ways (see scripts/sync-env.mjs):
#   wrangler workers  → generated apps/{api,mcp}/.dev.vars
#   vite (web)        → VITE_* keys, read natively via envDir
#   renderer scripts  → loaded into process.env

BETTER_AUTH_SECRET=dev-secret-change-me
# BETTER_AUTH_API_KEY (Better Auth cloud dashboard) lives in .env.local — it's a real secret
# TUNNEL_ORIGIN is written to .env.local by scripts/tunnel.sh when a dev tunnel is up
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
INTERNAL_API_KEY=dev-internal-key
DEV_ALLOW_ANON=1

VITE_API_URL=http://localhost:8787

PUBLIC_API_ORIGIN=http://localhost:8787

API_URL=http://localhost:8787
RENDER_PAGE_URL=http://localhost:5173/render.html
