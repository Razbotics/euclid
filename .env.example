# Template of every supported key. Committed — placeholders only, never real values.
#
#   .env        production values, real keys. GITIGNORED. Copy this file to start.
#   .env.local  per-machine overrides for local dev. GITIGNORED. Takes precedence.
#
# Precedence: real shell env > .env.local > .env
# Delivery:   scripts/sync-env.mjs → apps/{api,mcp}/.dev.vars
#             Vite reads VITE_* from the repo root (envDir)
#             renderer scripts import src/load-env.ts
# Production: set these as worker secrets — wrangler secret put <NAME>

# --- secrets ---
BETTER_AUTH_SECRET=          # 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_API_KEY=         # Better Auth cloud dashboard; same value prod and dev
INTERNAL_API_KEY=            # service-to-service auth (MCP + render workers → API)
ELEVENLABS_API_KEY=          # TTS provider
FAL_KEY=                     # fal.ai — generated images, video, music, 3D models
SOCIALCRAWL_API_KEY=         # socialcrawl.dev — import_social_video reads post links (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- origins ---
APP_ORIGIN=                  # frontend origin, used for CORS + Better Auth trust
PUBLIC_API_ORIGIN=           # API's public origin; used to build client-facing URLs.
                             # Must NOT be derived from the request — service-binding
                             # calls arrive with an internal hostname.
VITE_API_URL=                # what the browser calls
API_URL=                     # what the render worker calls
RENDER_PAGE_URL=             # headless export surface, e.g. <app>/render.html

# --- local-dev only (belongs in .env.local, never in production) ---
DEV_ALLOW_ANON=              # "1" lets sessionless requests act as 'dev-user'
TUNNEL_ORIGIN=               # written by scripts/tunnel.sh; trusted as an auth origin
